{
  "name": "tumblr-palette-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "eslintCheck": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typeCheck": "tsc --noEmit",
    "prettierCheck": "prettier --check . \"!**/*.{md,json,yaml,yml}\"",
    "test": "concurrently -g -c auto npm:eslintCheck npm:typeCheck npm:prettierCheck"
  },
  "dependencies": {
    "colorjs.io": "^0.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
